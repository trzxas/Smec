<Window x:Class="Smec.Test"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Smec"
        xmlns:model="clr-namespace:Smec.Models"
        mc:Ignorable="d"
        Title="Test" Height="300" Width="300">
    <Window.DataContext>
        <model:L2OR Name="D1">
            <model:L2OR.Ports>
                <model:NodePort Name="X11" Side="Left"/>
                <model:NodePort Name="X2" Side="Left"/>
                <model:NodePort Side="Left"/>
                <model:NodePort Name="X" Side="Left"/>

                <model:NodePort Name="Y1" Side="Right"/>
                <!--<model:NodePort Name="Y2" Side="Right"/>
                <model:NodePort Side="Right"/>
                <model:NodePort Side="Right"/>-->
            </model:L2OR.Ports>
        </model:L2OR>
    </Window.DataContext>
    <Canvas>
        <Border BorderBrush="Gray" Background="WhiteSmoke" BorderThickness="1"  CornerRadius="60" 
                Canvas.Top="30" Canvas.Left="20">
            <Grid ShowGridLines="True">

                <Grid.Resources>
                    <Style TargetType="ContentControl" x:Key="LeftPortStyle">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FlowDirection" Value="LeftToRight"/>
                    </Style>

                    <Style TargetType="ContentControl" x:Key="RightPortStyle" BasedOn="{StaticResource LeftPortStyle}">
                        <Setter Property="FlowDirection" Value="RightToLeft"/>
                    </Style>

                    <!-- ШАБЛОНЫ ДЛЯ ПОРТА -->
                    <DataTemplate x:Key="NodePortContentTemplateVL">
                        <Grid>
                            <Canvas VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Line X2="-8" Stroke="Gray" StrokeThickness="1"/>
                            </Canvas>
                            <TextBlock Text="{Binding Name}"  />
                        </Grid>
                    </DataTemplate>

                    <DataTemplate x:Key="NodePortContentTemplateVR">
                        <Grid>
                            <TextBlock Text="{Binding Name}"   HorizontalAlignment="Right"/>
                            <Canvas VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Line X2="8" Stroke="Gray" StrokeThickness="1" />
                            </Canvas>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate x:Key="NodePortContentTemplateHT">
                        <Grid MinWidth="6">
                            <TextBlock Text="{Binding Name}" Background="Aqua"/>
                            <Canvas VerticalAlignment="Top" HorizontalAlignment="Center">
                                <Line Y2="-8"  Stroke="Gray" StrokeThickness="1" />
                            </Canvas>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate x:Key="NodePortContentTemplateHB">
                        <Grid MinWidth="6">
                            <Canvas VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <Line Y2="8"  Stroke="Gray" StrokeThickness="1"/>
                            </Canvas>
                            <TextBlock Text="{Binding Name}"   VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate x:Key="NodePortContentTemplateRBC">
                        <Grid >
                            <Canvas VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                <Line X2="8" Y2="8"  Stroke="Gray" StrokeThickness="1"/>
                            </Canvas>
                            <TextBlock Text="{Binding Name}"   VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>

                </Grid.Resources>


                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Ports}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NodePortContentTemplateVL}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Ports}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NodePortContentTemplateVR}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Ports}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource  NodePortContentTemplateHT}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Ports}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource  NodePortContentTemplateHB}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

               

                <ItemsControl Grid.Row="2" Grid.Column="2" ItemsSource="{Binding Ports}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NodePortContentTemplateVR}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Side}" Value="Right">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Grid.Row="2" Grid.Column="2" ItemsSource="{Binding Ports}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource NodePortContentTemplateHB}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Side}" Value="Right">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl Grid.Row="2" Grid.Column="2" ItemsSource="{Binding Ports}"  VerticalAlignment="Bottom">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource  NodePortContentTemplateRBC}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Side}" Value="Left">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </Border>
        <Path Stroke="Gray" Data="M 0 8 L 4 8 L 4 0 L 8 0 L 8 8 L 12 8 "/>
    </Canvas>
</Window>
