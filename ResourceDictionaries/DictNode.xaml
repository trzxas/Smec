<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:Emulation.Models" 
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    >

    <DataTemplate x:Key="NodeTemplate" DataType="{x:Type models:Node}">
        <DataTemplate.Resources>
            <ResourceDictionary>
                <sys:Double x:Key="PinLen">10.0</sys:Double>
                <sys:Double x:Key="nPinLen">-10.0</sys:Double>
                <Style x:Key="NodeBorderStyle" TargetType="Border">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderBrush" Value="DarkGray"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
                <Style x:Key="VerticalLineContainerStyle" TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="0,2"/>
                </Style>
                <Style x:Key="HorizontalLineContainerStyle" TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="2,0"/>
                </Style>
                <Style x:Key="PortLineStyle" TargetType="Line">
                    <Setter Property="Stroke" Value="#0066CC"/>
                    <Setter Property="StrokeThickness" Value="1"/>
                    <Setter Property="StrokeStartLineCap" Value="Round"/>
                    <Setter Property="ToolTip" Value="{Binding Name}"/>
                </Style>
            </ResourceDictionary>
        </DataTemplate.Resources>

        <Border Name="MainNodeControl" Style="{StaticResource NodeBorderStyle}">
            <!-- задаем еффект тени -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#CCCCCC" Opacity="0.5" ShadowDepth="3"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <!--Подпись Node, используем Canvas чтобы можно было вылазить за пределы ячейки ClipToBounds=False -->
                <Canvas Grid.Row="0" Grid.Column="2" ClipToBounds="False">
                    <TextBlock Text="{Binding Name}"  Canvas.Left="{Binding ElementName=RightSide, Path=ActualWidth}" Canvas.Top="-16"/>
                </Canvas>

                
                
                <!--Left side-->
                <ItemsControl ItemsSource="{Binding LeftPorts}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" 
                              ItemContainerStyle="{StaticResource VerticalLineContainerStyle}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Name}" Margin="2,0,0,0"/>
                                <Line X1="{StaticResource nPinLen}"  VerticalAlignment="Center" Style="{StaticResource PortLineStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--Right side-->
                <ItemsControl Name="RightSide" ItemsSource="{Binding RightPorts}" Grid.Row="1" Grid.Column="2" 
                              VerticalAlignment="Center" HorizontalAlignment="Right" 
                              ItemContainerStyle="{StaticResource VerticalLineContainerStyle}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel  Orientation="Vertical" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Name}" Margin="0,0,2,0"/>
                                <Line X1="{StaticResource PinLen}"  VerticalAlignment="Center" HorizontalAlignment="Right" 
                                      Style="{StaticResource PortLineStyle}">
                                    <Line.Margin>
                                        <Thickness Right="{StaticResource nPinLen}"/>
                                    </Line.Margin>
                                </Line>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--Top side-->
                <ItemsControl ItemsSource="{Binding TopPorts}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" 
                              ItemContainerStyle="{StaticResource HorizontalLineContainerStyle}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Name}"/>
                                <Line Y1="{StaticResource nPinLen}"  HorizontalAlignment="Center" Style="{StaticResource PortLineStyle}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--Bottom Side-->
                <ItemsControl ItemsSource="{Binding BottomPorts}" Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" 
               ItemContainerStyle="{StaticResource HorizontalLineContainerStyle}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"  VerticalAlignment="Bottom"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Name}"/>
                                <Line Y2="{StaticResource PinLen}"  HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                                      Style="{StaticResource PortLineStyle}">
                                    <Line.Margin>
                                        <Thickness Bottom="{StaticResource nPinLen}"/>
                                    </Line.Margin>
                                </Line>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>