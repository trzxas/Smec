<UserControl x:Class="Smec.CustomControls.ControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Smec"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="200">

    <UserControl.Resources>
        <SolidColorBrush x:Key="buttonColor" Color="DarkBlue"/>
        <SolidColorBrush x:Key="actButtonColor" Color="OrangeRed"/>

        <Style x:Key="RectStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{StaticResource buttonColor}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="IsEnabled" Value="{Binding ElementName=StopSimulateButton, Path=IsChecked}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=IsChecked,RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource actButtonColor}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SimulatedButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Silver"/>
            <Setter Property="Margin" Value="1 0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="AntiqueWhite"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StartSimulButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource SimulatedButtonStyle}">
            <Setter Property="IsChecked" Value="False"/>
            <Setter Property="IsEnabled" Value="{Binding ElementName=StopSimulateButton, Path=IsChecked}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="{TemplateBinding Background}" >
                            <Polygon Points="0,0 16,8 0,16">
                                <Polygon.Style>
                                    <Style TargetType="Polygon">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Fill" Value="{StaticResource buttonColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource actButtonColor}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Polygon.Style>
                            </Polygon>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=StopSimulateButton, Path=IsChecked}" Value="False">
                    <Setter Property="IsChecked" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PauseSimulButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource SimulatedButtonStyle}">
            <Setter Property="IsChecked" Value="False"/>
            <Setter Property="IsEnabled" Value="{Binding ElementName=StartSimulateButton, Path=IsChecked}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Grid Background="{TemplateBinding Background}" >
                            <Rectangle Width="6" Height="16" Style="{StaticResource RectStyle}" Margin="5 0 0 0"/>
                            <Rectangle Width="6" Height="16" Style="{StaticResource RectStyle}" Margin="13 0 0 0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=StopSimulateButton, Path=IsChecked}" Value="True">
                    <Setter Property="IsChecked" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StopSimulButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource SimulatedButtonStyle}">
            <Setter Property="IsChecked" Value="True"/>
            <Setter Property="IsEnabled" Value="{Binding ElementName=StartSimulateButton, Path=IsChecked}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Grid Background="{TemplateBinding Background}">
                            <Rectangle Width="16" Height="16" Fill="{StaticResource buttonColor}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=StartSimulateButton, Path=IsChecked}" Value="True">
                    <Setter Property="IsChecked" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimerValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- Привязка к свойству самого ControlPanel -->
            <Setter Property="Text" Value="{Binding TimeValue, 
                                          RelativeSource={RelativeSource AncestorType=UserControl}, 
                                          StringFormat={}{0:hh\\:mm\\:ss\\.f}}"/>
            <Setter Property="IsEnabled" Value="{Binding ElementName=StartSimulateButton, Path=IsChecked}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        
        <TextBlock x:Name="TimerValue" Width="80" Style="{StaticResource TimerValueStyle}"/>
        
        <!-- Start запускает симуляцию -->
        <ToggleButton x:Name="StartSimulateButton" 
                  Width="24" 
                  Style="{StaticResource StartSimulButtonStyle}"
                  Command="{Binding StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <!-- Pause передает свое состояние IsChecked в качестве параметра команды -->
        <ToggleButton x:Name="PauseSimulateButton" 
                  Width="24" 
                  Style="{StaticResource PauseSimulButtonStyle}"
                  Command="{Binding PauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>

        <!-- Stop останавливает симуляцию -->
        <ToggleButton x:Name="StopSimulateButton" 
                  Width="24" 
                  Style="{StaticResource StopSimulButtonStyle}"
                  Command="{Binding StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </StackPanel>
</UserControl>
