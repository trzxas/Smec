<Window x:Class="Emulation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Emulation"
         xmlns:help="clr-namespace:Emulation.Helpers"
        
        xmlns:vm="clr-namespace:Emulation.ViewModels"
        mc:Ignorable="d"
        Title="{Binding CurrentFile}" Height="800" Width="1000" d:Height="150"  d:Width="1000"
        Background="DarkGray"
        Closing="Window_Closing">

    <d:Window.DataContext>
        <vm:SysViewModel/>
    </d:Window.DataContext>

    <Window.Resources>
        <!--Пока не нужно, может быть в будущем--> 
        <help:BindingProxy x:Key="VmProxy" Data="{help:WindowDataContextBinding}"/>
        <!-- Единое меню для всех нод , через BindingProxy-->
        <ContextMenu x:Key="_NodeContextMenu">
            <MenuItem Header="Удалить"
                  Command="{Binding Data.RemoveNodeCommand, Source={StaticResource VmProxy}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Клонировать"
                  Command="{Binding Data.CloneNodeCommand, Source={StaticResource VmProxy}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <!-- Единое меню для всех нод, через Tag и тогда BindingProxy не нужен-->
        <ContextMenu x:Key="NodeContextMenu">
            <MenuItem Header="Удалить"
                Command="{Binding PlacementTarget.Tag.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Клонировать"
                  Command="{Binding PlacementTarget.Tag.CloneNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- Головне меню програми -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File" >
                <!-- Прив'язка до команди OpenFileCommand з вашої MainViewModel -->
                <MenuItem Header="New" Command="{Binding NewFileCommand}" />
                <MenuItem Header="Open..." Command="{Binding OpenFileCommand}" />
                <MenuItem Header="Save" Command="{Binding SaveFileCommand}" />
                <MenuItem Header="SaveAs..." Command="{Binding SaveFileCommand}" CommandParameter="SaveAs" />
                <MenuItem Header="Import..." Command="{Binding ImportCommand}"/>
                <MenuItem Header="Export..." Command="{Binding ExportCommand}" />
                <MenuItem Header="Close" Command="{Binding CloseFileCommand}" />
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Options" Command="{Binding OptionsCommand}" />
            </MenuItem>
            <MenuItem Header="New" Command="{Binding NewFileCommand}" />
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>
        <Grid Background="{StaticResource GridBrush}" d:Visibility="Visible">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <!-- Если CurrentModel внутри DataContext (самой VM) равен null -->
                        <DataTrigger Binding="{Binding Path=CurrentModel}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <!--Список узлов  ItemTemplate="{StaticResource NodeTemplate }"-->
            <ItemsControl ItemsSource="{Binding Path=CurrentModel.Nodes}" 
                          MouseLeftButtonDown="Node_MouseLeftButtonDown">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas x:Name="NodeArea" ClipToBounds="True"  Background="Transparent"
                                AllowDrop="True" Drop="NodeArea_Drop" DragOver="NodeArea_DragOver"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Path=Location.X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Path=Location.Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}"
                            ContentTemplate="{StaticResource NodeTemplate}"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            ContextMenu="{StaticResource NodeContextMenu}">
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <!--<model:Node Location="10,20" Name="Test1"/>
                <model:Node Location="90,30" Name="Test2"/>-->
            </ItemsControl>

        </Grid>
    </DockPanel>
</Window>
