<Window x:Class="Smec.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Smec"
        xmlns:model="clr-namespace:Smec.Models"
        xmlns:vm="clr-namespace:Smec.ViewModels"
        xmlns:infra="clr-namespace:Smec.Infrastructure"
        xmlns:help="clr-namespace:Smec.Helpers"
        xmlns:cv="clr-namespace:Smec.Converters"
        xmlns:cc="clr-namespace:Smec.CustomControls"
        xmlns:c="comment"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        
        mc:Ignorable="d c"
        
        Title="{Binding CurrentFile}" Height="900" Width="1400" d:Height="150"  d:Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="DarkGray"
        FontSize="12"
        UseLayoutRounding="True"
        Closing="Window_Closing">

    <d:Window.DataContext>
        <vm:SysViewModel/>
    </d:Window.DataContext>

    <Window.Resources>



        <!-- Базовый стиль скрытия любого элемента при отсутствии загруженной модели -->
        <Style x:Key="HideWhenNoModelStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentModel}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <!--Пока не нужно, может быть в будущем-->
        <infra:BindingProxy x:Key="VmProxy" Data="{help:WindowDataContextBinding}"/>

        <!-- Единое меню для всех нод, через Tag и пример одного пункта меню с BindingProxy-->
        <ContextMenu x:Key="NodeContextMenu">
            <ContextMenu.Resources>
                <Style TargetType="Image">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Height" Value="10"/>
                </Style>
            </ContextMenu.Resources>


            <MenuItem Header="Клонировать"
                Command="{Binding PlacementTarget.Tag.CloneNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Image Source="/Img/copy_16.png"/>
                </MenuItem.Icon>
            </MenuItem>

            <!--Вариант использования привязки через BindingProxy, чтобы не использовать Tag-->
            <!--<MenuItem Header="Удалить"
                    Command="{Binding Data.RemoveNodeCommand, Source={StaticResource VmProxy}}"
                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Image Source="/Img/delete_24.png"/>
                </MenuItem.Icon>
            </MenuItem>-->

            <MenuItem Header="Удалить"
                Command="{Binding PlacementTarget.Tag.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Image Source="/Img/delete_16.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Свойства..."
                Command="{Binding PlacementTarget.Tag.NodePropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Image Source="/Img/properties.png"/>
                </MenuItem.Icon>
            </MenuItem>

        </ContextMenu>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.SelectAll" 
                        Executed="Window_SelectAll_Executed" 
                        CanExecute="Window_SelectAll_CanExecute" />
        <!--<CommandBinding Command="ApplicationCommands.New" 
                        Executed="{Binding NewFileCommand}"/>-->
    </Window.CommandBindings>

    <Window.InputBindings>
        <!-- Команды меню File -->
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewFileCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveFileCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveFileCommand}" CommandParameter="SaveAs"/>

        <!-- Команды меню Edit -->
        <KeyBinding Key="Delete" Command="{Binding RemoveSelectedNodesCommand}" />
        <KeyBinding Key="Back" Command="{Binding RemoveSelectedNodesCommand}" />

        <!-- Команды масштабирования (Zoom) -->
        <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="Add" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="Subtract" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="D0" Command="{Binding ResetZoomCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="NumPad0" Command="{Binding ResetZoomCommand}"/>
    </Window.InputBindings>

    <DockPanel LastChildFill="True">
        <!-- Головне меню програми -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File" >
                <!-- Привязка к командам OpenFileCommand с ViewModel -->
                <MenuItem Header="New" Command="{Binding NewFileCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Open..." Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="Save" Command="{Binding SaveFileCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save As..." Command="{Binding SaveFileCommand}" CommandParameter="SaveAs" InputGestureText="Ctrl+Shift+S"/>
                <MenuItem Header="Import..." Command="{Binding ImportCommand}"/>
                <MenuItem Header="Export..." Command="{Binding ExportCommand}" />
                <MenuItem Header="Close" Command="{Binding CloseFileCommand}" />
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="View">
                <!-- Масштаб -->
                <MenuItem Header="Zoom In" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++"/>
                <MenuItem Header="Zoom Out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-"/>
                <MenuItem Header="Reset Zoom" Command="{Binding ResetZoomCommand}" InputGestureText="Ctrl+0"/>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Select all" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" />
                <MenuItem Header="Clear selection" Command="{Binding ClearSelectionCommand}" InputGestureText="Esc" />

                <Separator />

                <MenuItem Header="Duplicate" Command="{Binding CloneSelectedNodesCommand}" InputGestureText="Ctrl+D">
                    <MenuItem.Icon>
                        <Image Source="/Img/copy_16.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Delete" InputGestureText="Del" Command="{Binding RemoveSelectedNodesCommand}">
                    <MenuItem.Icon>
                        <Image Source="/Img/delete_16.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Настройки">
                <MenuItem Header="Сетка">
                    <!-- Стиль отображения Сетки -->
                    <MenuItem Header="Линии" 
                        IsCheckable="True"
                        IsChecked="{Binding CurrentGridStyle, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, 
                        ConverterParameter={x:Static vm:GridStyleMode.Lines}}"
                        Command="{Binding SetGridStyleCommand}"
                        CommandParameter="{x:Static vm:GridStyleMode.Lines}" />
                    <MenuItem Header="Точки" IsCheckable="True"
                        IsChecked="{Binding CurrentGridStyle, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, 
                        ConverterParameter={x:Static vm:GridStyleMode.Dots}}"
                        Command="{Binding SetGridStyleCommand}"
                        CommandParameter="{x:Static vm:GridStyleMode.Dots}" />
                    <MenuItem Header="Без сетки" 
                        IsCheckable="True"
                        IsChecked="{Binding CurrentGridStyle, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, 
                        ConverterParameter={x:Static vm:GridStyleMode.None}}"
                        Command="{Binding SetGridStyleCommand}"
                        CommandParameter="{x:Static vm:GridStyleMode.None}" />
                </MenuItem>
                <!-- Шаг сетки -->
                <MenuItem Header="Шаг сетки">
                    <MenuItem Header="24 / 12 px" 
                        IsCheckable="True"
                        IsChecked="{Binding CurrentGridPreset, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, 
                                          ConverterParameter={x:Static vm:GridPreset.Grid24_12}}"
                        Command="{Binding SetGridPresetCommand}"
                        CommandParameter="{x:Static vm:GridPreset.Grid24_12}" />
                    <MenuItem Header="48 / 12 px" 
                        IsCheckable="True"
                        IsChecked="{Binding CurrentGridPreset, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, 
                                          ConverterParameter={x:Static vm:GridPreset.Grid48_12}}"
                        Command="{Binding SetGridPresetCommand}"
                        CommandParameter="{x:Static vm:GridPreset.Grid48_12}" />
                    <MenuItem Header="50 / 10 px" 
                        IsCheckable="True"
                        IsChecked="{Binding CurrentGridPreset, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, 
                                          ConverterParameter={x:Static vm:GridPreset.Grid50_10}}"
                        Command="{Binding SetGridPresetCommand}"
                        CommandParameter="{x:Static vm:GridPreset.Grid50_10}" />
                </MenuItem>
                <!-- Цветовая схема сетки-->
                <MenuItem Header="Цвет сетки">
                    <MenuItem Header="Светлая (Классическая)" Command="{Binding SetGridThemeCommand}" CommandParameter="Light" />
                    <MenuItem Header="Чертёжная (Голубая)" Command="{Binding SetGridThemeCommand}" CommandParameter="Blueprint" />
                    <MenuItem Header="Тёмная" Command="{Binding SetGridThemeCommand}" CommandParameter="Dark" />
                </MenuItem>

                <Separator />
                <MenuItem Header="Настройка Цветов..." Command="{Binding OptionsColorCommand}" />
            </MenuItem>
            <MenuItem Header="New" Command="{Binding NewFileCommand}" />
            <MenuItem Header="QuickLoad" Command="{Binding QuickLoadCommand}"  CommandParameter="test.prj"/>
        </Menu>

        <ToolBar DockPanel.Dock="Top" Background="LightGray">
            <Button Command="{Binding NewFileCommand}" ToolTip="New File">
                <Image Source="/Img/new-project_24.png" Width="24" Height="24"/>
            </Button>
            <Button Command="{Binding OpenFileCommand}" ToolTip="Open File">
                <Image Source="/Img/open-project_24.png" Width="24" Height="24"/>
            </Button>
            <Button Command="{Binding SaveFileCommand}" ToolTip="Save File">
                <Image Source="/Img/save-project_24.png" Width="24" Height="24"/>
            </Button>
            <Separator/>
            <!--<Button Command="{Binding ZoomInCommand}" ToolTip="Zoom In">
                <Image Source="/Img/zoom_in_24.png" Width="16" Height="16"/>
            </Button>
            <Button Command="{Binding ZoomOutCommand}" ToolTip="Zoom Out">
                <Image Source="/Img/zoom_out_24.png" Width="16" Height="16"/>
            </Button>
            <Button Command="{Binding ResetZoomCommand}" ToolTip="Reset Zoom">
                <Image Source="/Img/zoom_reset_24.png" Width="16" Height="16"/>
            </Button>-->
            <CheckBox Content="Подсвечивать связи" IsChecked="{Binding HighlightLinks, Mode=TwoWay}"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <!-- 1. Сначала прижимаем самый правый элемент (Zoom) -->
            <StatusBarItem DockPanel.Dock="Right" Style="{StaticResource HideWhenNoModelStyle}">
                <TextBlock x:Name="Zoom" Text="{Binding ZoomLevel, StringFormat='Zoom: {0:P0}'}" />
            </StatusBarItem>

            <!-- 2. Затем прижимаем панель кнопок вправо (она встанет левее Zoom) -->
            <StatusBarItem DockPanel.Dock="Right" BorderThickness="1" BorderBrush="Gray" Style="{StaticResource HideWhenNoModelStyle}">
                <cc:ControlPanel TimeValue="{Binding CurrentSimulationTime}"
                                 StartCommand="{Binding StartCommand}"
                                 PauseCommand="{Binding PauseCommand}"
                                 StopCommand="{Binding StopCommand}">
                </cc:ControlPanel>
            </StatusBarItem>

            <!-- 3. Последний элемент в коде займет всё оставшееся место слева -->
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Style="{StaticResource HideWhenNoModelStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="100" MaxWidth="400"/>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" MinWidth="150"/>
            </Grid.ColumnDefinitions>

            <!--Область доступных элементов-->
            <Grid>
                <!--Блокировка панели элементов при симуляции-->
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSimulating}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition MaxHeight="200"  MinHeight="50" Height="100"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!--Иконка выбранного элемента из списка StockListBox (для наглядности)-->
                <Border Grid.Row="0" Background="LightYellow" KeyboardNavigation.TabNavigation="None" Cursor="Hand"
                        Padding="12"
                        DataContext="{Binding ElementName=StockListBox, Path=SelectedItem}"
                        PreviewMouseLeftButtonDown="StockSource_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="StockSource_PreviewMouseLeftButtonUp"
                        PreviewMouseMove="StockSource_PreviewMouseMove">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=StockListBox, Path=SelectedItem}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Viewbox IsHitTestVisible="False">
                        <ContentControl x:Name="StockIcon"
                            ContentTemplate="{StaticResource StockNodeIcon}" Content="{Binding}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Viewbox>
                </Border>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="1" Background="Gray" VerticalAlignment="Center"/>

                <!--Список доступных элементов для добавления на рабочую область-->
                <ListBox Name="StockListBox" Grid.Row="2" ItemsSource="{Binding StockList}" 
                             ItemTemplate="{StaticResource StockNodeTemplate}" SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="White" 
                             PreviewMouseLeftButtonDown="StockSource_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="StockSource_PreviewMouseLeftButtonUp"
                             PreviewMouseMove="StockSource_PreviewMouseMove">
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" Background="Gray"  d:Background="Black" ResizeDirection="Auto" 
                          HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" />

            <!--Рабочая область-->
            <ScrollViewer Name="MainScrollViewer" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" >
                <Grid Name="WorkGrid" Background="{Binding WorkspaceGridBrush}" 
                        SnapsToDevicePixels="True"
                        d:Visibility="Visible" 
                        MinWidth="{Binding ContentWidth}"
                        MinHeight="{Binding ContentHeight}"
                        PreviewMouseWheel="WorkGrid_MouseWheel"
                        MouseLeftButtonDown="WorkGrid_MouseLeftButtonDown"
                        AllowDrop="True" 
                        DragOver="WorkGrid_DragOver" 
                        Drop="WorkGrid_Drop"
                        DragEnter="WorkGrid_DragEnter"
                        DragLeave="WorkGrid_DragLeave">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="RenderTransformOrigin" Value="0 0"/>
                            <Setter Property="Visibility" Value="Visible"/>
                        </Style>
                    </Grid.Style>

                    <!-- Подключаем  масштаб-->
                    <Grid.LayoutTransform>
                        <!--Или глобальный масштаб из App.xaml-->
                        <!--<DynamicResource ResourceKey="GlobalScaleTransform"/>-->

                        <!--Или из VM-->
                        <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                    </Grid.LayoutTransform>

                    <!-- СЛОЙ ПРОВОДОВ (размещается в WorkGrid ПЕРЕД NodesListBox, чтобы компоненты перекрывали концы проводов) -->
                    <ListBox x:Name="LinksListBox"
                                    ItemsSource="{Binding Links}"
                                    SelectionMode="Extended"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                RequestBringIntoView="ListBox_RequestBringIntoView"
                                PreviewMouseLeftButtonDown="LinksListBox_PreviewMouseLeftButtonDown"
                                PreviewMouseRightButtonDown="LinksListBox_PreviewMouseRightButtonDown"
                             ItemTemplate="{StaticResource LinkTemplate}">

                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding DeleteLinksCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=LinksListBox}"/>
                            <KeyBinding Key="Backspace" Command="{Binding DeleteLinksCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=LinksListBox}"/>
                        </ListBox.InputBindings>

                        <!-- Размещаем все провода на общем Canvas -->
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <!--Убираем встроенную рамку и отступ 2px у стандартного ListBox!-->
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ListBox.Template>

                        <!-- Контейнер каждого провода: синхронизирует выделение ListBox с LinkVm.IsSelected -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />

                                <!-- 1. Передаём сам LinksListBox в Tag (чтобы работали Tag.DataContext и Tag.SelectedItems) -->
                                <Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource AncestorType=ListBox}}" />

                                <!-- 2. Подключаем контекстное меню провода -->
                                <Setter Property="ContextMenu" Value="{StaticResource LinkContextMenu}" />

                                <!-- Убираем стандартный голубой прямоугольник выделения Windows вокруг всего провода -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Слой узловых точек (сварки) в местах разветвления проводов -->
                    <ItemsControl ItemsSource="{Binding Junctions}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:JunctionVm}">
                                <!-- Залитый кружок 4x4 px строго по центру точки (X, Y) -->
                                <Ellipse Width="4" Height="4" Margin="-2,-2,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource DefaultBrush}" />
                                            <Style.Triggers>
                                                <!-- Повторяем цвета логических уровней из LinkStyle -->
                                                <DataTrigger Binding="{Binding State}" Value="Low">
                                                    <Setter Property="Fill" Value="{StaticResource LowBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="High">
                                                    <Setter Property="Fill" Value="{StaticResource PosBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>


                    <!--Обновленная панель компонентов с поддержкой вращения и масштабирования. 
                    Внутри каждого компонента есть два слоя: вращаемый слой (корпус, HitBox и пины)
                    и неповорачиваемый слой (надписи).-->
                    <ListBox x:Name="ComponentsLayer" ItemsSource="{Binding  Components}"
                                KeyboardNavigation.TabNavigation="Continue"  Background="{x:Null}"
                                SelectionMode="Extended" 
   
                                PreviewKeyDown="NodeListBox_PreviewKeyDown"
                                PreviewMouseLeftButtonDown="NodeListBox_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="NodeListBox_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="NodeListBox_PreviewMouseLeftButtonUp"
                                SelectionChanged="NodeListBox_SelectionChanged"
                             ItemTemplateSelector="{StaticResource NodeTemplateSelector}"
                             >
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <!-- Убираем встроенную рамку и отступ 2px у стандартного ListBox! -->
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ListBox.Template>

                        <!-- Позиционирование всего компонента (включая надписи) на схеме -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <!-- Привязываем экранные пиксели из NodeVm -->
                                <Setter Property="Canvas.Left" Value="{Binding PixelX}" />
                                <Setter Property="Canvas.Top" Value="{Binding PixelY}" />
                                <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />

                                <!-- Синхронизируем выделение ListBoxItem с NodeVm.IsSelected -->
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />

                                <!-- Обнуляем стандартные отступы ListBoxItem, чтобы координаты клика не сбивались -->
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />

                                <!-- Убираем стандартный голубой квадрат выделения Windows вокруг ListBoxItem -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                                <!-- Проброс SysViewModel в Tag каждого ListBoxItem -->
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />

                                <!-- Подключаем контекстное меню -->
                                <Setter Property="ContextMenu" Value="{StaticResource NodeContextMenu}"/>

                                <!-- Триггер смены курсора на крест перемещения при выделении элемента -->
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Cursor" Value="SizeAll" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>



                    <!--Слой временной отрисовки элементов, например при создании связи-->
                    <Canvas x:Name="OverlayLayer" IsHitTestVisible="False">
                        <Line X1="{Binding PendingStartPoint.X}" Y1="{Binding PendingStartPoint.Y}"
                              X2="{Binding PendingEndPoint.X}" Y2="{Binding PendingEndPoint.Y}"
                            Stroke="{StaticResource DefaultBrush}"
                            StrokeThickness="1.5"
                            StrokeDashArray="2 2"
                            Opacity="0.7"
                            Visibility="{Binding IsCreatingLink, Converter={StaticResource BoolToVis}}" />
                    </Canvas>


                    <!-- Прямоугольник рамки выделения (Rubber Band) -->
                    <Rectangle x:Name="SelectionBox"
                                Visibility="Collapsed"
                                Stroke="DodgerBlue"
                                StrokeThickness="1"
                                StrokeDashArray="4 2"
                                Fill="#221E90FF"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
