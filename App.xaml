<Application x:Class="Emulation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Emulation"
             >
    <Application.Resources>
        <ResourceDictionary>
            <DrawingBrush x:Key="GridBrush" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <!-- СЛОЙ 1: ФОН (Закрашиваем весь квадрат 24x24) -->
                        <GeometryDrawing Brush="{local:WindowDataContextBinding Path=CurrentGridBackground}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,24,24" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>

                        <!-- СЛОЙ 2: ЛИНИИ СЕТКИ (Рисуются поверх фона) -->
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="{local:WindowDataContextBinding Path=CurrentGridBrush}" Thickness="0.5"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="24,0" />
                                    <LineGeometry StartPoint="0,0" EndPoint="0,24" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ResourceDictionaries/DictNode.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
    </Application.Resources>
</Application>
