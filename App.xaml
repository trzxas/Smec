<Application x:Class="Smec.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:help="clr-namespace:Smec.Helpers"
             >
    <Application.Resources>
        <ResourceDictionary>
            <!-- Глобальный объект трансформации масштаба -->
            <ScaleTransform x:Key="GlobalScaleTransform" ScaleX="1.0" ScaleY="1.0"/>

            <DrawingBrush x:Key="GridBrush" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <!-- СЛОЙ 1: ФОН -->
                        <GeometryDrawing Brush="{help:WindowDataContextBinding Path=CurrentGridBackground}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,24,24" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>

                        <!-- СЛОЙ 2 (Опционально): Промежуточные линии на 12px -->
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="{help:WindowDataContextBinding Path=CurrentGridBrush}" Thickness="0.25"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,12" EndPoint="24,12" />
                                    <LineGeometry StartPoint="12,0" EndPoint="12,24" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>

                        <!-- СЛОЙ 3: Основные линии сетки 24px -->
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="{help:WindowDataContextBinding Path=CurrentGridBrush}" Thickness="0.5"/>
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="24,0" />
                                    <LineGeometry StartPoint="0,0" EndPoint="0,24" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>


            <DrawingBrush x:Key="EngineeringGridBrush" 
              TileMode="Tile" 
              Viewport="0,0,60,60" 
              ViewportUnits="Absolute"
              Stretch="None">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <!-- 1. Фон холста -->
                        <GeometryDrawing Brush="White">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,60,60" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>

                        <!-- 2. Тонкие линии сетки с шагом 12px -->
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#F0F0F0" Thickness="1" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <!-- Вертикальные линии (12, 24, 36, 48) -->
                                    <LineGeometry StartPoint="12,0" EndPoint="12,60" />
                                    <LineGeometry StartPoint="24,0" EndPoint="24,60" />
                                    <LineGeometry StartPoint="36,0" EndPoint="36,60" />
                                    <LineGeometry StartPoint="48,0" EndPoint="48,60" />
                                    <!-- Горизонтальные линии (12, 24, 36, 48) -->
                                    <LineGeometry StartPoint="0,12" EndPoint="60,12" />
                                    <LineGeometry StartPoint="0,24" EndPoint="60,24" />
                                    <LineGeometry StartPoint="0,36" EndPoint="60,36" />
                                    <LineGeometry StartPoint="0,48" EndPoint="60,48" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>

                        <!-- 3. Более заметные опорные линии каждые 60px (5 ячеек по 12px) -->
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#DCDCDC" Thickness="1" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="0,60" />
                                    <LineGeometry StartPoint="0,0" EndPoint="60,0" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            
            

            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ResourceDictionaries/DefaultDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

           

        </ResourceDictionary>
        
    </Application.Resources>
</Application>
